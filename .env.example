# ==========================================
# Local for Vocal v2 - Environment Config
# ==========================================

PORT=5000
NODE_ENV=development
JWT_SECRET=localforvocal_dev_super_secret_jwt_key_2026

# Database Configuration (SQLite is default, Zero-config)
DB_TYPE=sqlite
SQLITE_PATH=server/data/localforvocal.db

# Optional: PostgreSQL Database URL (If switching to Postgres)
# DATABASE_URL=postgres://postgres:acceptmeanyways@localhost:5432/localforvocal

# ==========================================
# REAL MOBILE SMS GATEWAY PROVIDERS
# Add ANY ONE of these to receive real SMS on your phone:
# ==========================================

# Option 1: Fast2SMS (India - Fastest & Free Trial credits at https://fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 2: 2Factor.in (India - Dedicated High Speed OTP at https://2factor.in)
# TWO_FACTOR_API_KEY=your_2factor_api_key_here

# Option 3: Twilio (Global SMS at https://twilio.com)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
